# Copy to backend/.env. Public clone starts without external model calls.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# To use a compatible model: set LLM_PROVIDER=openai and fill your own key/model.
# On non-Windows hosts use LLM_TRANSPORT=python. No key is shipped to the client.
LLM_TRANSPORT=python

# Optional external WeChat reminders; leave empty for local foreground reminders.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REMINDER_TEMPLATE_ID=
WECHAT_TEMPLATE_DATA={"thing1":"每日科研记录","thing2":"和AI聊聊今天做了什么","time3":"{datetime}"}
WECHAT_SUBSCRIPTION_KIND=once
WECHAT_MINIPROGRAM_STATE=developer
